# Yerel geliştirmede DATABASE_URL vermeyin → SQLite kullanılır.
# Dokploy / Docker Compose için Postgres örneği:
# DATABASE_URL=postgres://jircode:jircode@db:5432/jircode

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=jircode.com,www.jircode.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://jircode.com,https://www.jircode.com
SITE_EMAIL=hello@jircode.com
SITE_LOCATION=Türkiye
SECURE_SSL_REDIRECT=False
SEED_PROJECTS=True
PORT=8000

# Opsiyonel: ilk deploy'da admin kullanıcısı
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@jircode.com
# DJANGO_SUPERUSER_PASSWORD=guclu-bir-sifre
