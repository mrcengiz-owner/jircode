# Dokploy Environment Variables
# DATABASE_URL = Dokploy Postgres → Internal Connection URL

DATABASE_URL=postgresql://USER:PASSWORD@postgres-HOST:5432/jircode

SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DEBUG=False
ALLOWED_HOSTS=jircode.com,www.jircode.com
CSRF_TRUSTED_ORIGINS=https://jircode.com,https://www.jircode.com
# Apex isteklerini www'ye 301 yapar (Django)
CANONICAL_HOST=www.jircode.com
SITE_EMAIL=hello@jircode.com
SITE_LOCATION=Türkiye
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
PORT=8000

SEED_PROJECTS=True
SEED_MENUS=True

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@jircode.com
DJANGO_SUPERUSER_PASSWORD=guclu-admin-sifresi-degistirin
